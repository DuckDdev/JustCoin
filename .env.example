# --- Telegram ---
# Токен бота от @BotFather. Без кавычек и пробелов вокруг.
BOT_TOKEN=

# ID администраторов через запятую. Узнать свой: написать боту @userinfobot
ADMIN_IDS=

# Владельцы бота. Получают статус «Создатель» — он сильнее «Админа».
# Тот же формат, что у ADMIN_IDS.
CREATOR_IDS=

# --- Валюта ---
# Кулдаун получения и диапазон награды за одно получение
CLAIM_COOLDOWN_SECONDS=10800
CLAIM_MIN_AMOUNT=1
CLAIM_MAX_AMOUNT=5

# --- Курьер ---
# COURIER_CHANCE=0.01 — шанс 1 из 100 при получении коинов
COURIER_CHANCE=0.01
COURIER_PACKAGE_MIN=10
COURIER_PACKAGE_MAX=50
COURIER_DELAY_MIN_SECONDS=1800
COURIER_DELAY_MAX_SECONDS=10800
COURIER_CHECK_INTERVAL=30

# --- Топ ---
TOP_SIZE=10

# --- Апгрейды (секретный Jarvis Shop) ---
# Состав каталога и цены задаются в bot/config.py (UPGRADES).
# UPGRADE_COST — цена стартового апгрейда x2 (для совместимости)
UPGRADE_COST=1
UPGRADE_MODE=permanent

# --- «Замедлись» ---
# Если бот был оффлайн, игрок пропустил цикл получения. При возврате
# бота множитель ожидания растёт, показывая, насколько игрок отстал.
SLOWDOWN_ENABLED=1
# Минимальный множитель при первом простое и потолок при долгих простоях
SLOWDOWN_MIN_MULTIPLIER=2
SLOWDOWN_MAX_MULTIPLIER=20
# Через сколько часов множитель затухает до единицы
SLOWDOWN_DECAY_HOURS=24
# Простой короче этого порога замедлением не считается (в секундах)
SLOWDOWN_OFFLINE_THRESHOLD=600

# --- JustID ---
# Короткая ссылка на профиль вида $John. Границы допустимой длины
# имени без префикса $.
JUSTID_MIN_LENGTH=3
JUSTID_MAX_LENGTH=24

# --- Рассылка ---
# Ограничения по частоте нет: /announce доступен на каждый вызов.
# ANNOUNCE_MAX_CHATS — предохранитель, больше этого числа чатов за раз
# бот не берёт.
ANNOUNCE_MAX_CHATS=5000

# --- Баны ---
# Причина, которую подставляет /ban, если админ её не указал
DEFAULT_BAN_REASON=Нарушение правил

# --- Прочее ---
# Антиспам: не чаще раза в N секунд на игрока.
# Админские команды и администраторы от него не отсекаются.
ANTISPAM_COOLDOWN=1
DEFAULT_MAINTENANCE_REASON=Технические работы
LOG_LEVEL=INFO
DB_PATH=justcoin.db
STARTUP_NOTIFY_ADMINS=1
